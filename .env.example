# ===== Feishu App Config =====
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_ENCRYPT_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# ===== Claude Code CLI =====
CLAUDE_CLI_PATH=claude
CLAUDE_DEFAULT_MODEL=sonnet
CLAUDE_DATA_DIR=

# ===== Profile Switching =====
# Provider profiles are stored as settings_*.json in ~/.claude/
# Use /switch command in Feishu to switch between providers (GLM, Kimi, etc.)

# ===== Workspace =====
DEFAULT_WORKSPACE=

# ===== Approval Config =====
APPROVAL_TIMEOUT=600
# Default approval mode: h=⚡全自动模式(高容忍100%全放行) m=⚖️平衡模式(只读放行,写入需审批) l=🛡️严格模式(低容忍全审批)
APPROVAL_MODE=m

# ===== Hook Config (used by scripts/hooks/pre_tool_use.py) =====
MYCLAW_HOST=localhost
MYCLAW_PORT=8080

# ===== Access Control =====
ALLOWED_USERS=ou_xxxxxxxxxxxxxxxx,ou_xxxxxxxxxxxxxxxx

# ===== Audit Config =====
AUDIT_LOG_PATH=./audit.log

# ===== Server Config =====
HOST=0.0.0.0
PORT=8080
