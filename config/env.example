# ===== Feishu App Config =====
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_ENCRYPT_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# ===== WeCom 智能机器人（企业微信，长连接模式）=====
# 管理后台 → 管理工具 → 智能机器人 → 创建 → 开启 API 模式(长连接) 后获取
# 运行 setup.cmd 选择"企业微信"可交互配置并实测连通
WECOM_BOT_ID=
WECOM_SECRET=

# ===== 通道选择 =====
# 留空 = 自动探测（配置了 FEISHU_APP_ID 启用飞书，配置了 WECOM_BOT_ID 启用企微）
# 显式指定：feishu / wecom / feishu,wecom
MYCLAW_CHANNELS=

# ===== Claude Code CLI =====
CLAUDE_CLI_PATH=claude
CLAUDE_DEFAULT_MODEL=sonnet
CLAUDE_DATA_DIR=

# ===== Profile Switching =====
# Provider profiles are stored as settings_*.json in ~/.claude/
# Use /provider command in Feishu to switch between providers (GLM, Kimi, etc.)

# ===== Workspace =====
DEFAULT_WORKSPACE=

# ===== Approval Config =====
APPROVAL_TIMEOUT=600
# Default approval mode: h=🛡️严格模式(高风险全审批) m=⚖️平衡模式(只读放行,写入需审批) l=⚡全自动模式(低风险高容忍全放行)
APPROVAL_MODE=m

# ===== Hook Config (used by scripts/hooks/pre_tool_use.py) =====
MYCLAW_HOST=localhost
MYCLAW_PORT=8080

# ===== Access Control =====
# 飞书访问白名单（飞书 open_id，逗号分隔；留空 = 飞书全员可用）
ALLOWED_USERS=ou_xxxxxxxxxxxxxxxx,ou_xxxxxxxxxxxxxxxx
# 企业微信访问白名单（企业微信 userid，逗号分隔；留空 = 企微全员可用）
WECOM_ALLOWED_USERS=

# ===== Audit Config =====
AUDIT_LOG_PATH=./logs/audit.log

# ===== Server Config =====
HOST=0.0.0.0
PORT=8080
